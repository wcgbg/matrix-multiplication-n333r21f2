common --enable_platform_specific_config
common --incompatible_strict_action_env

# Set your preferred compiler here
# build --repo_env=CC=/usr/bin/clang
# build --repo_env=CXX=/usr/bin/clang++

build --cxxopt=-std=c++20
build --cxxopt=-Wall

# Linux specific configuration
build:linux --features=-layering_check

# Apple Clang specific configuration
build:macos --copt=-mmacosx-version-min=13.3
build:macos --linkopt=-mmacosx-version-min=13.3
build:macos --linkopt=-Wl,-no_warn_duplicate_libraries

# Maximum-speed configuration:
build:opt -c opt
build:opt --copt=-march=native
build:opt --copt=-O3
build:opt --copt=-flto
build:opt --linkopt=-flto

# Suppress warnings from third-party dependencies
build --per_file_copt=external/.*@-w

# Debug configuration
build:debug -c dbg
build:debug --strip=never
build:debug --copt=-g
build:debug --copt=-O0
build:debug --copt=-D_GLIBCXX_DEBUG
build:debug --linkopt=-g
# Both compile and link instrumentation are required. These flags work with
# Clang and GCC; Clang-only integer sanitization is intentionally not enabled
# because the hashing and finite-field code uses defined unsigned wraparound.
build:debug --copt=-fsanitize=address,undefined
build:debug --linkopt=-fsanitize=address,undefined
build:debug --copt=-fno-sanitize-recover=all
build:debug --linkopt=-fno-sanitize-recover=all
build:debug --copt=-fno-omit-frame-pointer
build:debug --spawn_strategy=local
